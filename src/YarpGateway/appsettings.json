{
  "ReverseProxy": {
    "Routes": {
      "wallet-create": {
        "ClusterId": "wallet-service",
        "Match": {
          "Path": "/api/wallets",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "mutations"
      },
      "wallet-deposit": {
        "ClusterId": "wallet-service",
        "Match": {
          "Path": "/api/deposit",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "mutations"
      },
      "wallet-withdraw": {
        "ClusterId": "wallet-service",
        "Match": {
          "Path": "/api/withdraw",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "mutations"
      },
      "transaction-history": {
        "ClusterId": "transaction-history-service",
        "Match": {
          "Path": "/api/history",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "wallet-service": {
        "Destinations": {
          "wallet": {
            "Address": "http://wallet-service:8080/"
          }
        }
      },
      "transaction-history-service": {
        "Destinations": {
          "history": {
            "Address": "http://transaction-history-service:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
